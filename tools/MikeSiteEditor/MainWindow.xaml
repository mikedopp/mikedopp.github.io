<Window x:Class="MikeSiteEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mike Site Editor"
        Icon="Assets/AppIcon.ico"
        Height="860"
        MinHeight="680"
        MinWidth="1040"
        Width="1280"
        Background="#111827">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#111827"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#172033"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#1f2937"/>
        <SolidColorBrush x:Key="BorderBrushDark" Color="#334155"/>
        <SolidColorBrush x:Key="TextBrush" Color="#e5e7eb"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9ca3af"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#38bdf8"/>
        <SolidColorBrush x:Key="InputBrush" Color="#0f172a"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#22c55e"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#f59e0b"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="SelectionBrush" Value="#2563eb"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="BorderBrush" Value="#2563eb"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1f2937"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource WindowBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#020617"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#020617"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="#0f172a"/>
            <Setter Property="AlternatingRowBackground" Value="#111827"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="HeaderGitStatusButton" Content="Git Status" Click="GitStatus_Click" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="HeaderCommitPushButton" Content="Commit + Push" Click="CommitPush_Click"/>
                </StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="54" Height="54" Background="#0f172a" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Margin="0,0,14,0">
                        <Image Source="Assets/AppIcon.png" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Mike Site Editor"/>
                            <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedTextBrush}" Margin="12,2,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="RepoPathText" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="LastActionText" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0" Text="Ready"/>
                    </StackPanel>
                </DockPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1">
            <TabItem Header="Blog Post">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="Title"/>
                            <TextBox x:Name="BlogTitleBox" SpellCheck.IsEnabled="True" TextChanged="BlogPreviewInputChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Subtitle"/>
                            <TextBox x:Name="BlogSubtitleBox" SpellCheck.IsEnabled="True" TextChanged="BlogPreviewInputChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <Label Content="Post date"/>
                            <DatePicker x:Name="BlogDatePicker"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="Tags, comma-separated"/>
                            <TextBox x:Name="BlogTagsBox" TextChanged="BlogPreviewInputChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Author"/>
                            <TextBox x:Name="BlogAuthorBox" SpellCheck.IsEnabled="True" TextChanged="BlogPreviewInputChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <Label Content="Video URL"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Embed" Click="InsertBlogEmbed_Click"/>
                                <TextBox x:Name="BlogVideoUrlBox"/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="BlogBodyBox"
                             Grid.Row="2"
                             Grid.Column="0"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Consolas"
                             FontSize="14"
                             HorizontalScrollBarVisibility="Auto"
                             Language="en-US"
                             SpellCheck.IsEnabled="True"
                             TextChanged="BlogPreviewInputChanged"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>

                    <WrapPanel Grid.Row="3" Grid.Column="0" Margin="0,10,0,0">
                        <Button Content="New Draft" Click="NewBlog_Click"/>
                        <Button Content="Insert Image" Click="InsertBlogImage_Click"/>
                        <Button Content="Insert Video File" Click="InsertBlogVideoFile_Click"/>
                        <Button Content="Save Post" Click="SavePost_Click"/>
                        <Button Content="Refresh Preview" Click="RefreshBlogPreview_Click"/>
                    </WrapPanel>

                    <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="6">
                        <WebBrowser x:Name="BlogPreviewBrowser"/>
                    </Border>
                    <GridSplitter Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Width="8" Margin="4,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Full Page Editor">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="Page"/>
                            <ComboBox x:Name="PagePicker" SelectionChanged="PagePicker_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Title"/>
                            <TextBox x:Name="PageTitleBox" SpellCheck.IsEnabled="True" TextChanged="PagePreviewInputChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <Label Content="Subtitle"/>
                            <TextBox x:Name="PageSubtitleBox" SpellCheck.IsEnabled="True" TextChanged="PagePreviewInputChanged"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,10">
                        <Label Content="Video URL"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Embed" Click="InsertPageEmbed_Click"/>
                            <TextBox x:Name="PageVideoUrlBox"/>
                        </DockPanel>
                    </StackPanel>

                    <TextBox x:Name="PageBodyBox"
                             Grid.Row="2"
                             Grid.Column="0"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Consolas"
                             FontSize="14"
                             HorizontalScrollBarVisibility="Auto"
                             Language="en-US"
                             SpellCheck.IsEnabled="True"
                             TextChanged="PagePreviewInputChanged"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>

                    <WrapPanel Grid.Row="3" Grid.Column="0" Margin="0,10,0,0">
                        <Button Content="Reload Pages" Click="ReloadPages_Click"/>
                        <Button Content="Insert Image" Click="InsertPageImage_Click"/>
                        <Button Content="Insert Video File" Click="InsertPageVideoFile_Click"/>
                        <Button Content="Save Page" Click="SavePage_Click"/>
                        <Button Content="Refresh Preview" Click="RefreshPagePreview_Click"/>
                    </WrapPanel>

                    <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="6">
                        <WebBrowser x:Name="PagePreviewBrowser"/>
                    </Border>
                    <GridSplitter Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Width="8" Margin="4,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Latest Projects">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="ProjectsGrid" AutoGenerateColumns="False" CanUserAddRows="True" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="1.2*"/>
                            <DataGridTextColumn Header="URL" Binding="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                        <Button Content="Add Project" Click="AddProject_Click"/>
                        <Button Content="Remove Selected" Click="RemoveProject_Click"/>
                        <Button Content="Save Projects" Click="SaveProjects_Click"/>
                        <Button Content="Reload Projects" Click="ReloadProjects_Click"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="PublishTab" Header="Publish">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="GitSummaryText" FontSize="18" FontWeight="SemiBold" Text="Git status not checked yet"/>
                                <TextBlock x:Name="GitBranchText" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,8,0,0"
                                           Text="GitHub publish uses local git credentials. For MFA/2FA, sign in with Git Credential Manager, use a personal access token for HTTPS, or switch the remote to SSH."
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="PublishGitStatusButton"
                                    Grid.Column="1"
                                    Content="Refresh Status"
                                    Click="GitStatus_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    VerticalAlignment="Top"/>
                            <Button x:Name="PublishCommitPushButton"
                                    Grid.Column="2"
                                    Content="Commit + Push"
                                    Click="CommitPush_Click"
                                    VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Content="Commit message"/>
                            <TextBox x:Name="CommitMessageBox" Text="Update site content"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.35*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Changed files" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListBox x:Name="GitChangesList" Grid.Row="1"/>

                        <GridSplitter Grid.Column="1" Grid.RowSpan="2" Width="8" Margin="4,0"/>

                        <TextBlock Grid.Column="2" Text="Activity log" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBox x:Name="StatusLogBox"
                                 Grid.Row="1"
                                 Grid.Column="2"
                                 AcceptsReturn="True"
                                 Background="#020617"
                                 BorderBrush="{StaticResource BorderBrushDark}"
                                 FontFamily="Consolas"
                                 Foreground="#d1d5db"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
