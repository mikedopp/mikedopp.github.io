    {
      "name": "Primary Front-Panel Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one primary action per surface (Email); yellow with a green LED.",
      "html": "<a class=\"ds-btn-primary\" href=\"#\"><span class=\"ds-led\" aria-hidden=\"true\"></span>Email Mike</a>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:10px;min-height:50px;padding:0 22px;border:1px solid #8F7A06;border-radius:6px;background:var(--tape,#F2D024);color:var(--tape-ink,#121417);font-family:Archivo,'Arial Narrow',system-ui,sans-serif;font-size:.9375rem;font-stretch:90%;font-weight:750;letter-spacing:.06em;text-transform:uppercase;text-decoration:none;box-shadow:0 2px 5px -1px rgba(18,20,23,.35);transition:transform 140ms cubic-bezier(.16,1,.3,1),box-shadow 140ms cubic-bezier(.16,1,.3,1),background-color 140ms cubic-bezier(.16,1,.3,1)}.ds-btn-primary:hover{background:#F7DA3C;transform:translateY(-1px);box-shadow:0 6px 12px -4px rgba(18,20,23,.4)}.ds-btn-primary:active{transform:translateY(1px);box-shadow:0 1px 2px rgba(18,20,23,.3)}.ds-btn-primary:focus-visible{outline:3px solid #121417;outline-offset:3px}.ds-led{width:9px;height:9px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#C9F7D4 0 18%,#33C25A 55%);box-shadow:0 0 0 1px rgba(0,0,0,.3),0 0 7px 1px rgba(51,194,90,.55)}@media (prefers-reduced-motion:reduce){.ds-btn-primary{transition:none}}"
    },
    {
      "name": "Steel Front-Panel Button",
      "kind": "button",
      "refersTo": "button-steel",
      "description": "Secondary actions (LinkedIn, GitHub).",
      "html": "<a class=\"ds-btn-steel\" href=\"#\">LinkedIn</a>",
      "css": ".ds-btn-steel{display:inline-flex;align-items:center;min-height:50px;padding:0 22px;border:1px solid #0C0E10;border-radius:6px;background:var(--steel-800,#2A2F34);color:var(--ink-inv,#EEF1F3);font-family:Archivo,'Arial Narrow',system-ui,sans-serif;font-size:.9375rem;font-stretch:90%;font-weight:750;letter-spacing:.06em;text-transform:uppercase;text-decoration:none;box-shadow:0 2px 5px -1px rgba(18,20,23,.35);transition:transform 140ms cubic-bezier(.16,1,.3,1),box-shadow 140ms cubic-bezier(.16,1,.3,1),background-color 140ms cubic-bezier(.16,1,.3,1)}.ds-btn-steel:hover{background:var(--steel-700,#3A4148);transform:translateY(-1px);box-shadow:0 6px 12px -4px rgba(18,20,23,.4)}.ds-btn-steel:active{transform:translateY(1px);box-shadow:0 1px 2px rgba(18,20,23,.3)}.ds-btn-steel:focus-visible{outline:3px solid #F2D024;outline-offset:3px}"
